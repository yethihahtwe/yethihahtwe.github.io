---
import ProfilePicture from '../assets/pfp.png';

import Layout from '../layouts/Layout.astro';
import ImageGlow from '../components/ImageGlow.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { name, openGraph } from 'spectre:globals';

const socials = await getCollection('socials');
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	pagefindIgnore
>
	<div class="home" slot="404">
		<ImageGlow quality={100} width={96} height={96} src={ProfilePicture} alt="Profile image of Ye Thi Ha Htwe" loading='eager' />
		<h1 class="text-glow">{name}</h1>
		<!-- ponytail: reuses the navbar's Pagefind search instead of a second search box -->
		<button class="search-button" onclick="document.getElementById('search').focus()">Search (Ctrl+K)</button>
		<ul class="links">
			<li><a href="/blog">Blog</a></li>
			<li><a href="/projects">Projects</a></li>
			<li><a href="/books">Books</a></li>
			{socials.map((item) => (
				<li>
					<a href={item.data.link} aria-label={item.data.text}>
						<Icon type={item.data.icon.type} name={item.data.icon.name as any} width={24} height={24} class='glow-icon' />
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>

<style>
	.home {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		min-height: 70vh;
		text-align: center;
	}

	.search-button {
		width: min(36rem, 100%);
		padding: .75rem 1.25rem;
		border: 1px solid var(--primary);
		border-radius: 999px;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: text;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
